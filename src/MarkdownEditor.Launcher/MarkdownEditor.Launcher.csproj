<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MarkdownEditor</AssemblyName>
    <Version>2.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\assets\markdown-editor.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="$(AppBundlePath)" LogicalName="MarkdownEditor.bundle.zip" />
  </ItemGroup>
</Project>
